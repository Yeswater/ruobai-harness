{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The vendored framework is compiled with these relaxations upstream
    // (see vendor/cordis/tsconfig.json). A single-program skeleton cannot
    // apply per-directory options; split into package tsconfigs once the
    // harness grows its own build graph.
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"]
  },
  "include": [
    "vendor/*/src",
    "packages/*/src",
    "packages/*/client",
    "packages/*/tests",
    "apps/*/src",
    "apps/*/tests",
    "tests",
    "vitest.config.ts"
  ],
  "exclude": [
    "packages/ui-app"
  ]
}
